# Database Configuration
DATABASE_URL=postgres://user:password@localhost:5432/controlplane?sslmode=disable

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Keys (RSA 2048-bit)
# You can generate keys using: openssl genrsa -out private.pem 2048
# And: openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Server Configuration
PORT=8080
